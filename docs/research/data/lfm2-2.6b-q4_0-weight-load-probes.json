  "blocked_speed_attribution": {
    "question": "The sweep's only plain (unblocked) record is at the committed tile (32,32,64), while the blocked record that showed 0.948 ms is at tile (32,32,32). Comparing those two numbers mixes a tile-shape change with a staging change. Was the blocked 0.948 ms a staging win, or just a better tile?",
    "method": "Re-measured plain, unblocked staging at three tiles including (32,32,32), interleaved rep by rep so clock or thermal drift lands on all tiles equally. Same weight, same inputs, same dot_width 4 and the same seven-sample-equivalent protocol reduced to three reps (first rep acts as warm-up for every tile).",
    "weight": "blk.0.ffn_gate.weight (k=2048, o=10752), dot_width 4",
    "records": [
      {
        "tile": [
          32,
          32,
          32
        ],
        "samples_ms": [
          1.544,
          1.025,
          1.001
        ],
        "median_ms": 1.025,
        "note": "First rep is a warm-up outlier, as expected for the tile sampled first; the median is unaffected."
      },
      {
        "tile": [
